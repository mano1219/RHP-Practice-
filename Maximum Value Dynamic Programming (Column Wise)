#include <iostream>
using namespace std;

int main()
{
    int a[3][3];

    for(int i=0;i<3;i++)
    {
        for(int j=0;j<3;j++)
        {
            cin >> a[i][j];
        }
    }

    for(int j=0;j<3;j++)
    {
        int max = a[0][j];

        for(int i=1;i<3;i++)
        {
            if(a[i][j] > max)
                max = a[i][j];
        }

        cout << max << endl;
    }

    return 0;
}
