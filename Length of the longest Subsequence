#include <iostream>
using namespace std;

int main()
{
    int n;
    cout << "Enter number of elements: ";
    cin >> n;

    int a[100], dp[100];

    cout << "Enter array elements:\n";
    for (int i = 0; i < n; i++)
    {
        cin >> a[i];
        dp[i] = 1;
    }

    // Find LIS
    for (int i = 1; i < n; i++)
    {
        for (int j = 0; j < i; j++)
        {
            if (a[i] > a[j] && dp[i] < dp[j] + 1)
            {
                dp[i] = dp[j] + 1;
            }
        }
    }

    int maxLen = 0;

    for (int i = 0; i < n; i++)
    {
        if (dp[i] > maxLen)
            maxLen = dp[i];
    }

    cout << "Length of Longest Increasing Subsequence = " << maxLen;

    return 0;
}
