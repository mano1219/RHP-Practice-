#include <iostream>
using namespace std;

int main()
{
    int row, col;
    cout << "Enter rows and columns: ";
    cin >> row >> col;

    int a[100][100];

    cout << "Enter matrix:\n";
    for (int i = 0; i < row; i++)
    {
        for (int j = 0; j < col; j++)
        {
            cin >> a[i][j];
        }
    }

    int x, y;
    cout << "Enter row and column index: ";
    cin >> x >> y;

    int sum = 0;

    if (x > 0)
        sum += a[x - 1][y];

    if (x < row - 1)
        sum += a[x + 1][y];

    if (y > 0)
        sum += a[x][y - 1];

    if (y < col - 1)
        sum += a[x][y + 1];

    cout << "Sum of adjacent cells = " << sum;

    return 0;
}
