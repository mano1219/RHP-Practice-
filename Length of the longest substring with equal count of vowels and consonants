#include <iostream>
#include <string>
using namespace std;

bool isVowel(char ch)
{
    ch = tolower(ch);

    if (ch == 'a' || ch == 'e' || ch == 'i' || ch == 'o' || ch == 'u')
        return true;

    return false;
}

int main()
{
    string s;
    cout << "Enter a string: ";
    cin >> s;

    int maxLen = 0;

    for (int i = 0; i < s.length(); i++)
    {
        int vowel = 0, consonant = 0;

        for (int j = i; j < s.length(); j++)
        {
            if (isVowel(s[j]))
                vowel++;
            else
                consonant++;

            if (vowel == consonant)
            {
                int len = j - i + 1;

                if (len > maxLen)
                    maxLen = len;
            }
        }
    }

    cout << "Length of longest substring = " << maxLen;

    return 0;
}
