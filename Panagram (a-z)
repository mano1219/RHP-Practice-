#include <iostream>
#include <string>
using namespace std;

int main()
{
    string s;
    cout << "Enter a sentence: ";
    getline(cin, s);

    int count = 0;

    for(char ch = 'a'; ch <= 'z'; ch++)
    {
        if(s.find(ch) != string::npos || s.find(ch - 32) != string::npos)
        {
            count++;
        }
    }

    if(count == 26)
        cout << "Pangram";
    else
        cout << "Not Pangram";

    return 0;
}
