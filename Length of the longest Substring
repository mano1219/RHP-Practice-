#include <iostream>
#include <string>
using namespace std;

int main()
{
    string s;
    cout << "Enter a string: ";
    cin >> s;

    int maxLen = 0;

    for (int i = 0; i < s.length(); i++)
    {
        bool visited[256] = {false};
        int len = 0;

        for (int j = i; j < s.length(); j++)
        {
            if (visited[s[j]])
                break;

            visited[s[j]] = true;
            len++;
        }

        if (len > maxLen)
            maxLen = len;
    }

    cout << "Length of longest substring = " << maxLen;

    return 0;
}
