#include <iostream>
using namespace std;

int row, col;
int matrix[100][100];
int dp[100][100];

int dfs(int i, int j)
{
    if (dp[i][j] != 0)
        return dp[i][j];

    int maxLen = 1;

    // Down
    if (i + 1 < row && matrix[i + 1][j] > matrix[i][j])
        maxLen = max(maxLen, 1 + dfs(i + 1, j));

    // Up
    if (i - 1 >= 0 && matrix[i - 1][j] > matrix[i][j])
        maxLen = max(maxLen, 1 + dfs(i - 1, j));

    // Right
    if (j + 1 < col && matrix[i][j + 1] > matrix[i][j])
        maxLen = max(maxLen, 1 + dfs(i, j + 1));

    // Left
    if (j - 1 >= 0 && matrix[i][j - 1] > matrix[i][j])
        maxLen = max(maxLen, 1 + dfs(i, j - 1));

    dp[i][j] = maxLen;
    return maxLen;
}

int main()
{
    cout << "Enter rows and columns: ";
    cin >> row >> col;

    cout << "Enter matrix:\n";
    for (int i = 0; i < row; i++)
    {
        for (int j = 0; j < col; j++)
        {
            cin >> matrix[i][j];
            dp[i][j] = 0;
        }
    }

    int answer = 0;

    for (int i = 0; i < row; i++)
    {
        for (int j = 0; j < col; j++)
        {
            answer = max(answer, dfs(i, j));
        }
    }

    cout << "Longest Increasing Path = " << answer;

    return 0;
}
